--------------------------------------------------
-- START MOVEMENT CHECK
--------------------------------------------------

local GRACE_TIME = 0.5

local function startFreezeCheck()

    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local root = character:WaitForChild("HumanoidRootPart")

    fallenAngelActive = true

    if movementCheck then
        movementCheck:Disconnect()
        movementCheck = nil
    end

    -- You have 0.5 seconds to move into position
    local graceEnd = os.clock() + GRACE_TIME

    -- Position that becomes locked after the 2 seconds
    local lockedPosition = nil

    print("Fallen Angel movement check started.")
    print("You have 0.5 seconds to choose your position.")

    movementCheck = RunService.Heartbeat:Connect(function()

        --------------------------------------------------
        -- CRUCIFIED / BANISHED
        --------------------------------------------------

        if isBanished() then
            print("Fallen Angel was crucified - movement allowed!")
            stopFreezeCheck()
            return
        end

        --------------------------------------------------
        -- ENTITY NO LONGER ACTIVE
        --------------------------------------------------

        if not fallenAngelActive then
            stopFreezeCheck()
            return
        end

        if not character.Parent or humanoid.Health <= 0 then
            stopFreezeCheck()
            return
        end

        --------------------------------------------------
        -- 0.5 SECOND MOVEMENT PERIOD
        --------------------------------------------------

        if os.clock() < graceEnd then
            return
        end

        --------------------------------------------------
        -- LOCK POSITION
        --------------------------------------------------

        if lockedPosition == nil then
            lockedPosition = root.Position

            print("Position locked! Do not move.")

            return
        end

        --------------------------------------------------
        -- CHECK FOR MOVEMENT
        --------------------------------------------------

        local distanceMoved =
            (root.Position - lockedPosition).Magnitude

        if distanceMoved > 0.05 then

            --------------------------------------------------
            -- FINAL CRUCIFIX CHECK
            --------------------------------------------------

            if isBanished() then
                stopFreezeCheck()
                return
            end

            print("Fallen Angel detected movement!")

            --------------------------------------------------
            -- DEATH CAUSE
            --------------------------------------------------

            pcall(function()
                game.ReplicatedStorage.GameStats
                    ["Player_" .. player.Name]
                    .Total.DeathCause.Value = "Fallen Angel"
            end)

            --------------------------------------------------
            -- STOP CHECK
            --------------------------------------------------

            stopFreezeCheck()

            --------------------------------------------------
            -- JUMPSCARE
            --------------------------------------------------

            task.spawn(playFallenAngelJumpscare)

            --------------------------------------------------
            -- KILL
            --------------------------------------------------

            humanoid.Health = 0

            return
        end
    end)
end

