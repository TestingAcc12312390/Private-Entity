--------------------------------------------------
-- JUMPSCARE FUNCTION
--------------------------------------------------

local function playFallenAngelJumpscare()

    -- Remove old jumpscare
    pcall(function()
        local old = CoreGui:FindFirstChild("JumpscareGui")
        if old then
            old:Destroy()
        end
    end)

    local config = {
        Image1 = "rbxassetid://0",
        Image2 = "rbxassetid://111970164409344",

        Sound1 = {0, {Volume = 10}},
        Sound2 = {18564431123, {Volume = 10}},

        Shake = true
    }

    -- Sound loader
    local function loadSound(data)
        local sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://" .. tostring(data[1])

        for property, value in pairs(data[2] or {}) do
            if property ~= "SoundId" and property ~= "Parent" then
                sound[property] = value
            end
        end

        sound.Parent = workspace
        return sound
    end

    -- GUI
    local gui = Instance.new("ScreenGui")
    gui.Name = "JumpscareGui"
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = CoreGui

    local bg = Instance.new("Frame")
    bg.Size = UDim2.fromScale(1, 1)
    bg.BackgroundColor3 = Color3.new(0, 0, 0)
    bg.BorderSizePixel = 0
    bg.ZIndex = 999
    bg.Parent = gui

    local face = Instance.new("ImageLabel")
    face.AnchorPoint = Vector2.new(0.5, 0.5)
    face.Position = UDim2.fromScale(0.5, 0.5)
    face.Size = UDim2.fromOffset(150, 150)
    face.BackgroundTransparency = 1
    face.Image = config.Image1
    face.ZIndex = 1000
    face.Parent = bg

    local screenY = gui.AbsoluteSize.Y
    local maxSize = screenY / 2.5

    -- Sounds
    local sound1 = loadSound(config.Sound1)
    local sound2 = loadSound(config.Sound2)

    sound1:Play()

    -- Flash
    task.spawn(function()
        while gui.Parent do
            bg.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            task.wait(0.05)

            if not gui.Parent then
                break
            end

            bg.BackgroundColor3 = Color3.new(0, 0, 0)
            task.wait(0.05)
        end
    end)

    -- Shake
    if config.Shake then
        task.spawn(function()
            local basePosition = face.Position

            while gui.Parent do
                face.Position =
                    basePosition +
                    UDim2.fromOffset(
                        math.random(-10, 10),
                        math.random(-10, 10)
                    )

                face.Rotation = math.random(-5, 5)

                task.wait()
            end
        end)
    end

    -- Final jumpscare
    task.wait(0.2)

    face.Image = config.Image2
    face.Size = UDim2.fromOffset(maxSize, maxSize)

    sound2:Play()

    local tween = TweenService:Create(
        face,
        TweenInfo.new(0.75),
        {
            Size = UDim2.fromOffset(screenY * 3, screenY * 3),
            ImageTransparency = 0.5
        }
    )

    tween:Play()

    task.wait(0.75)

    -- Cleanup
    if sound1 then
        sound1:Destroy()
    end

    if sound2 then
        sound2:Destroy()
    end

    if gui then
        gui:Destroy()
    end
end

--------------------------------------------------
-- FREEZE CHECK
--------------------------------------------------

local function startFreezeCheck()

    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local root = character:WaitForChild("HumanoidRootPart")

    if movementCheck then
        movementCheck:Disconnect()
        movementCheck = nil
    end

    local lastPosition = root.Position

    movementCheck = RunService.Heartbeat:Connect(function()

        if not character.Parent or humanoid.Health <= 0 then
            if movementCheck then
                movementCheck:Disconnect()
                movementCheck = nil
            end

            return
        end

        local currentPosition = root.Position

        -- PLAYER MOVED
        if (currentPosition - lastPosition).Magnitude > 0.05 then

            -- Set death cause BEFORE death
            pcall(function()
                game.ReplicatedStorage.GameStats
                    ["Player_" .. player.Name]
                    .Total.DeathCause.Value = "Fallen Angel"
            end)

            -- Stop movement detection
            movementCheck:Disconnect()
            movementCheck = nil

            -- Play jumpscare
            task.spawn(playFallenAngelJumpscare)

            -- Kill player
            humanoid.Health = 0

            return
        end

        lastPosition = currentPosition
    end)
end

