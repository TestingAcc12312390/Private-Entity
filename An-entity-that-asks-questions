--------------------------------------------------
-- SPAWN
--------------------------------------------------

local function SpawnQuestioner()

	local Room =
		GetCurrentRoom()

	if not Room then

		warn(
			"Questioner: room not found."
		)

		return false
	end

	local SpawnPosition,FloorY =
		GetRandomFloorPosition(Room)

	if not SpawnPosition
		or not FloorY then

		return false
	end

	Entity.Parent =
		workspace

	AnchorEntity()

	local CurrentPivot =
		Entity:GetPivot()

	local Rotation =
		CurrentPivot -
		CurrentPivot.Position

	local Bounds =
		GetEntityBounds()

	if not Bounds then

		Entity:Destroy()
		return false
	end

	local UndergroundBottom =
		FloorY -
		UNDERGROUND_DEPTH

	local UndergroundCenterY =
		UndergroundBottom +
		Bounds.Size.Y / 2

	Entity:PivotTo(
		CFrame.new(
			SpawnPosition.X,
			UndergroundCenterY,
			SpawnPosition.Z
		) * Rotation
	)

	AnchorEntity()

	local Start =
		os.clock()

	while os.clock() - Start < RISE_DELAY do

		if Dead
			or not Entity
			or not Entity.Parent then

			return false
		end

		AnchorEntity()

		RunService.RenderStepped:Wait()
	end

	Bounds =
		GetEntityBounds()

	if not Bounds then
		return false
	end

	--------------------------------------------------
	-- FIXED FLOOR RISE
	--------------------------------------------------

	local RiseDistance =
		FloorY -
		Bounds.Bottom

	if RiseDistance < 0 then
		RiseDistance = 0
	end

	local StartPivot =
		Entity:GetPivot()

	local TargetPivot =
		StartPivot +
		Vector3.new(
			0,
			RiseDistance,
			0
		)

	local Value =
		Instance.new("CFrameValue")

	Value.Value =
		StartPivot

	local Connection =
		Value:GetPropertyChangedSignal(
			"Value"
		):Connect(
			function()

				if Entity
					and Entity.Parent then

					Entity:PivotTo(
						Value.Value
					)

					AnchorEntity()
				end
			end
		)

	local Tween =
		TweenService:Create(
			Value,
			TweenInfo.new(
				RISE_TIME,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),
			{
				Value = TargetPivot
			}
		)

	Tween:Play()
	Tween.Completed:Wait()

	Connection:Disconnect()
	Value:Destroy()

	Bounds =
		GetEntityBounds()

	if Bounds then

		local Correction =
			FloorY -
			Bounds.Bottom

		Entity:PivotTo(
			Entity:GetPivot() +
			Vector3.new(
				0,
				Correction,
				0
			)
		)
	end

	AnchorEntity()

	FreezePlayer()

	return true
end

--------------------------------------------------
-- APPROACH
--------------------------------------------------

local function ApproachPlayer()

	if Dead
		or CrucifixInProgress then

		return false
	end

	if not Entity
		or not Entity.Parent then

		return false
	end

	task.wait(0.5)

	local LockedY =
		Entity:GetPivot().Position.Y

	local Target =
		PlayerRoot.Position +
		PlayerRoot.CFrame.LookVector *
		ENTITY_DISTANCE

	local TargetPosition =
		Vector3.new(
			Target.X,
			LockedY,
			Target.Z
		)

	while Entity
		and Entity.Parent
		and not Dead
		and not CrucifixInProgress do

		local Current =
			Entity:GetPivot().Position

		local Difference =
			Vector3.new(
				TargetPosition.X - Current.X,
				0,
				TargetPosition.Z - Current.Z
			)

		local Distance =
			Difference.Magnitude

		if Distance <= 0.2 then
			break
		end

		local Delta =
			RunService.RenderStepped:Wait()

		local Step =
			math.min(
				APPROACH_SPEED * Delta,
				Distance
			)

		local NewPosition =
			Current +
			Difference.Unit *
			Step

		NewPosition =
			Vector3.new(
				NewPosition.X,
				LockedY,
				NewPosition.Z
			)

		local Look =
			PlayerRoot.Position -
			NewPosition

		Look =
			Vector3.new(
				Look.X,
				0,
				Look.Z
			)

		if Look.Magnitude < 0.01 then
			Look =
				Vector3.new(0,0,-1)
		end

		Entity:PivotTo(
			CFrame.lookAt(
				NewPosition,
				NewPosition + Look.Unit
			)
		)

		AnchorEntity()
	end

	return true
end

