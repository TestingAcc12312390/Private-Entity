--------------------------------------------------
-- CRUCIFY
--------------------------------------------------

local function Crucify(Tool)

	if CrucifixInProgress
		or Dead
		or EncounterFinished then

		return
	end

	if not Entity
		or not Entity.Parent then

		return
	end

	if not Tool
		or not Tool:IsA("Tool")
		or not Normalize(Tool.Name):find("crucifix") then

		return
	end

	--------------------------------------------------
	-- LOCK
	--------------------------------------------------

	CrucifixInProgress = true

	DialogueToken += 1

	StopMusic()

	DestroyQuestionUI()
	DestroyRiddleUI()

	--------------------------------------------------
	-- EQUIP
	--------------------------------------------------

	pcall(function()
		Humanoid:EquipTool(Tool)
	end)

	task.wait(0.15)

	--------------------------------------------------
	-- ACTIVATE
	--------------------------------------------------

	pcall(function()
		Tool:Activate()
	end)

	AnchorEntity()

	--------------------------------------------------
	-- BLUE CRUCIFIX
	--------------------------------------------------

	local BlueCrucifix =
		CreateBlueCrucifix()

	--------------------------------------------------
	-- ENTITY SPEAKS
	--------------------------------------------------

	CrucifixDialogueSequence()

	--------------------------------------------------
	-- REMOVE BLUE CRUCIFIX
	--------------------------------------------------

	if BlueCrucifix
		and BlueCrucifix.Parent then

		BlueCrucifix:Destroy()
	end

	--------------------------------------------------
	-- BANISH ENTITY
	--------------------------------------------------

	if Entity
		and Entity.Parent then

		AnchorEntity()

		local Start =
			Entity:GetPivot()

		local Value =
			Instance.new("CFrameValue")

		Value.Value =
			Start

		local Connection =
			Value:GetPropertyChangedSignal(
				"Value"
			):Connect(
				function()

					if Entity
						and Entity.Parent then

						Entity:PivotTo(
							Value.Value
						)

						AnchorEntity()
					end
				end
			)

		local Tween =
			TweenService:Create(
				Value,
				TweenInfo.new(
					1.5,
					Enum.EasingStyle.Quad,
					Enum.EasingDirection.In
				),
				{
					Value =
						Start +
						Vector3.new(
							0,
							-30,
							0
						)
				}
			)

		Tween:Play()
		Tween.Completed:Wait()

		Connection:Disconnect()
		Value:Destroy()
	end

	--------------------------------------------------
	-- DESTROY ENTITY
	--------------------------------------------------

	if Entity
		and Entity.Parent then

		Entity:Destroy()
	end

	--------------------------------------------------
	-- ONE USE
	--------------------------------------------------

	if Tool
		and Tool.Parent then

		pcall(function()
			Tool:Destroy()
		end)
	end

	--------------------------------------------------
	-- ACHIEVEMENT
	--------------------------------------------------

	GiveAchievement(
		"Bravest Person Alive",
		"I never thought you actually did this.",
		"Use a Crucifix against Questioner",
		"rbxassetid://8738909464"
	)

	--------------------------------------------------
	-- FINISH
	--------------------------------------------------

	EncounterFinished = true

	StopMusic()

	DestroyQuestionUI()
	DestroyRiddleUI()
	DestroyDialogue()

	UnfreezePlayer()
end

