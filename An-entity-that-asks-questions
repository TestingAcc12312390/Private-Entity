local function GetRoot()

	if not Entity or not Entity.Parent then
		return nil
	end

	if Entity:IsA("BasePart") then
		return Entity
	end

	if Entity:IsA("Model") then

		if Entity.PrimaryPart then
			return Entity.PrimaryPart
		end

		local Root =
			Entity:FindFirstChild("HumanoidRootPart", true)
			or Entity:FindFirstChild("RootPart", true)
			or Entity:FindFirstChild("Main", true)
			or Entity:FindFirstChildWhichIsA("BasePart", true)

		if Root then
			Entity.PrimaryPart = Root
			return Root
		end
	end

	return nil
end

--------------------------------------------------
-- ANCHOR ENTITY
--------------------------------------------------

local function AnchorEntity()

	if not Entity or not Entity.Parent then
		return
	end

	local function Setup(Object)

		if not Object:IsA("BasePart") then
			return
		end

		Object.Anchored = true
		Object.CanCollide = false
		Object.CanTouch = false
		Object.CanQuery = false

		Object.AssemblyLinearVelocity = Vector3.zero
		Object.AssemblyAngularVelocity = Vector3.zero
	end

	if Entity:IsA("BasePart") then
		Setup(Entity)
	else

		for _, Object in ipairs(Entity:GetDescendants()) do
			Setup(Object)
		end

	end
end

