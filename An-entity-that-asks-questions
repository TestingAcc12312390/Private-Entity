local function GetPlayerFloor(Room)

	if not Room then
		return nil
	end

	local Params =
		RaycastParams.new()

	Params.FilterType =
		Enum.RaycastFilterType.Exclude

	Params.FilterDescendantsInstances = {
		Character,
		Entity
	}

	Params.IgnoreWater = true

	local Position =
		PlayerRoot.Position

	local Result =
		workspace:Raycast(
			Vector3.new(
				Position.X,
				Position.Y + 3,
				Position.Z
			),
			Vector3.new(0,-25,0),
			Params
		)

	if Result
		and Result.Instance
		and Result.Instance:IsDescendantOf(Room)
		and Result.Normal.Y > 0.7 then

		return Result.Position.Y
	end

	local Result2 =
		workspace:Raycast(
			Vector3.new(
				Position.X,
				Position.Y + 8,
				Position.Z
			),
			Vector3.new(0,-40,0),
			Params
		)

	if Result2
		and Result2.Instance
		and Result2.Instance:IsDescendantOf(Room)
		and Result2.Normal.Y > 0.7 then

		return Result2.Position.Y
	end

	return nil
end

--------------------------------------------------
-- RANDOM FLOOR POSITION
--------------------------------------------------

local function GetRandomFloorPosition(Room)

	if not Room then
		return nil,nil
	end

	local RoomCF, RoomSize =
		Room:GetBoundingBox()

	local HalfX =
		math.max(
			RoomSize.X / 2 - ROOM_MARGIN,
			2
		)

	local HalfZ =
		math.max(
			RoomSize.Z / 2 - ROOM_MARGIN,
			2
		)

	local PlayerFloor =
		GetPlayerFloor(Room)

	if not PlayerFloor then

		PlayerFloor =
			PlayerRoot.Position.Y -
			(Humanoid.HipHeight + 2)
	end

	for _ = 1,RANDOM_ATTEMPTS do

		local X =
			(math.random() * 2 - 1) * HalfX

		local Z =
			(math.random() * 2 - 1) * HalfZ

		local World =
			RoomCF:PointToWorldSpace(
				Vector3.new(X,0,Z)
			)

		local Params =
			RaycastParams.new()

		Params.FilterType =
			Enum.RaycastFilterType.Exclude

		Params.FilterDescendantsInstances = {
			Character,
			Entity
		}

		Params.IgnoreWater = true

		local Result =
			workspace:Raycast(
				Vector3.new(
					World.X,
					PlayerFloor + 5,
					World.Z
				),
				Vector3.new(0,-15,0),
				Params
			)

		if Result
			and Result.Instance
			and Result.Instance:IsDescendantOf(Room)
			and Result.Normal.Y > 0.7
			and math.abs(
				Result.Position.Y - PlayerFloor
			) <= 5 then

			return Vector3.new(
				World.X,
				PlayerFloor,
				World.Z
			),PlayerFloor
		end
	end

	return Vector3.new(
		RoomCF.Position.X,
		PlayerFloor,
		RoomCF.Position.Z
	),PlayerFloor
end

