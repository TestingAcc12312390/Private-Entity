	Answer.ClearTextOnFocus = false

	Answer.Font =
		Enum.Font.Gotham

	Answer.Parent =
		Main

	local AnswerCorner =
		Instance.new("UICorner")

	AnswerCorner.CornerRadius =
		UDim.new(0,8)

	AnswerCorner.Parent =
		Answer

	local Submit =
		Instance.new("TextButton")

	Submit.Size =
		UDim2.fromScale(0.5,0.13)

	Submit.Position =
		UDim2.fromScale(0.25,0.73)

	Submit.Text =
		"SUBMIT"

	Submit.TextScaled = true

	Submit.TextColor3 =
		Color3.new(1,1,1)

	Submit.BackgroundColor3 =
		Color3.fromRGB(55,55,55)

	Submit.Font =
		Enum.Font.GothamBold

	Submit.Parent =
		Main

	local SubmitCorner =
		Instance.new("UICorner")

	SubmitCorner.CornerRadius =
		UDim.new(0,8)

	SubmitCorner.Parent =
		Submit

	StartRiddleMusic()

	local Finished =
		false

	local Remaining =
		RIDDLE_TIME

	local function Complete()

		if Finished
			or Dead
			or CrucifixInProgress
			or EncounterFinished then

			return
		end

		local Input =
			Normalize(
				Answer.Text
			)

		if Input == "" then
			return
		end

		--------------------------------------------------
		-- WRONG RIDDLE
		--------------------------------------------------

		if not IsCorrect(
			Input,
			Riddle
		) then

			Finished = true

			RiddleText.Text =
				"WRONG!"

			task.wait(0.6)

			DestroyRiddleUI()
			StopMusic()

			if not DialogueSequence({
				{"Bro can't even solve a riddle",2}
			}) then
				return
			end

			KillPlayer()

			return
		end

		--------------------------------------------------
		-- CORRECT
		--------------------------------------------------

		Finished = true

		RiddleText.Text =
			"CORRECT!"

		task.wait(0.8)

		DestroyRiddleUI()
		StopMusic()

		--------------------------------------------------
		-- SUCCESS MESSAGE 1
		-- FADE IN
		--------------------------------------------------

		if not DialogueFadeIn(
			"Congratulations on answering 5 Question and 1 Riddle.",
			2.5
		) then

			return
		end

		--------------------------------------------------
		-- SUCCESS MESSAGE 2
		-- NORMAL
		--------------------------------------------------

		if not Dialogue(
			"You are smarter than i thought.",
			2.2
		) then

			return
		end

		--------------------------------------------------
		-- SUCCESS MESSAGE 3
		-- NORMAL
		--------------------------------------------------

		if not Dialogue(
			"You may go.",
			1.8
		) then

			return
		end

		--------------------------------------------------
		-- SUCCESS MESSAGE 4
		-- FADE OUT 2.2 SECONDS
		--------------------------------------------------

		if not DialogueFadeOut(
			"See you later.",
			2.2
		) then

			return
		end

		--------------------------------------------------
		-- FINISH
		--------------------------------------------------

		RiddleFinished = true
		EncounterFinished = true

		GiveAchievement(
			"Smartest Person Alive",
			"You're smarter than i thought.",
			"Encounter and Survive Questioner",
			"rbxassetid://7567254565"
		)

		DestroyDialogue()

		if Entity
			and Entity.Parent then

			Entity:Destroy()
		end

		UnfreezePlayer()
	end

	Submit.MouseButton1Click:Connect(
		Complete
	)

	Answer.FocusLost:Connect(
		function(EnterPressed)

			if EnterPressed then
				Complete()
			end
		end
	)

	task.spawn(function()

		while Remaining > 0
			and not Finished
			and not Dead
			and not CrucifixInProgress do

			task.wait(1)

			if Finished
				or Dead
				or CrucifixInProgress then

				break
			end

			Remaining -= 1

			if Timer
				and Timer.Parent then

				Timer.Text =
					"TIME: " ..
					math.max(
						Remaining,
						0
					)

				if Remaining <= 5 then

					Timer.TextColor3 =
						Color3.fromRGB(
							255,
							60,
							60
						)
				end
			end
		end

		if Remaining <= 0
			and not Finished
			and not Dead
			and not CrucifixInProgress then

			Finished = true

			DestroyRiddleUI()
			StopMusic()

			if not DialogueSequence({
				{"You are smart but still a failure",2}
			}) then

				return
			end

			KillPlayer()
		end
	end)
end

--------------------------------------------------
-- SPAWN
--------------------------------------------------

if not SpawnQuestioner() then

	if Entity
		and Entity.Parent then

		Entity:Destroy()
	end

	return
end

--------------------------------------------------
-- APPROACH
--------------------------------------------------

if not ApproachPlayer() then

	UnfreezePlayer()

	if Entity
		and Entity.Parent then

		Entity:Destroy()
	end

	return
end

--------------------------------------------------
-- START CRUCIFIX MONITOR
--------------------------------------------------

StartCrucifixMonitor()

task.wait(0.2)

if CrucifixInProgress
	or EncounterFinished
	or Dead then

	return
end

--------------------------------------------------
-- INTRO
--------------------------------------------------

if not DialogueFadeIn(
	"Hello, Player.",
	2
) then

	return
end

if not DialogueSequence({

	{"I have some questions for you.",2},

	{"You have 60 seconds to answer them all.",2.5},

	{"Answer incorrectly and you will die.",2.5},

	{"Good luck.",2}

}) then

	return
end

--------------------------------------------------
-- SELECT QUESTIONS
--------------------------------------------------

local Pool = {}

for _,Question in ipairs(
	QUESTIONS
) do

	table.insert(
		Pool,
		Question
	)
end

Shuffle(Pool)

for i = 1,
	QUESTIONS_PER_ENCOUNTER do

	SelectedQuestions[i] =
		Pool[i]
end

--------------------------------------------------
-- QUESTION UI
--------------------------------------------------

local UI =
	CreateQuestionUI()

if not UI then
	return
end

UI.Update()

StartQuestionMusic()

--------------------------------------------------
-- CHECK QUESTION
--------------------------------------------------

local function CheckQuestion()

	if Dead
		or EncounterFinished
		or CrucifixInProgress
		or QuestionsFinished then

		return
	end

	local Data =
		SelectedQuestions[
			CurrentQuestion
		]

	if not Data then
		return
	end

	local Input =
		Normalize(
			UI.Answer.Text
		)

	if Input == "" then
		return
	end

	--------------------------------------------------
	-- WRONG
	--------------------------------------------------

	if not IsCorrect(
		Input,
		Data
	) then

		UI.QuestionText.Text =
			"WRONG ANSWER!"

		task.wait(0.6)

		DestroyQuestionUI()
		StopMusic()

		if not DialogueSequence({
			{"Yeah, you are dumb",2}
		}) then

			return
		end

		KillPlayer()

		return
	end

	--------------------------------------------------
	-- NEXT
	--------------------------------------------------

	if CurrentQuestion <
		QUESTIONS_PER_ENCOUNTER then

		CurrentQuestion += 1

		UI.Update()

	else

		StartRiddle()
	end
end

--------------------------------------------------
-- SUBMIT
--------------------------------------------------

UI.Submit.MouseButton1Click:Connect(
	CheckQuestion
)

UI.Answer.FocusLost:Connect(
	function(EnterPressed)

		if EnterPressed then
			CheckQuestion()
		end
	end
)

--------------------------------------------------
-- QUESTION TIMER
--------------------------------------------------

task.spawn(function()

	while TimeLeft > 0
		and not Dead
		and not EncounterFinished
		and not QuestionsFinished
		and not CrucifixInProgress do

