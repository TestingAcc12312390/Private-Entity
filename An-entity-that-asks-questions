local function DialogueFadeIn(Message,Duration)

	if Dead or EncounterFinished then
		return false
	end

	DialogueToken += 1

	local Token =
		DialogueToken

	ShowDialogue()

	DialogueText.Text =
		Message

	DialogueText.TextTransparency = 1
	DialogueName.TextTransparency = 1
	DialogueBox.BackgroundTransparency = 1

	local Info =
		TweenInfo.new(
			0.5,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		)

	local BoxTween =
		TweenService:Create(
			DialogueBox,
			Info,
			{
				BackgroundTransparency = 0.08
			}
		)

	local NameTween =
		TweenService:Create(
			DialogueName,
			Info,
			{
				TextTransparency = 0
			}
		)

	local TextTween =
		TweenService:Create(
			DialogueText,
			Info,
			{
				TextTransparency = 0
			}
		)

	BoxTween:Play()
	NameTween:Play()
	TextTween:Play()

	local Start =
		os.clock()

	while os.clock() - Start < Duration do

		if Dead
			or EncounterFinished
