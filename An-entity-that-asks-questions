--------------------------------------------------
-- NORMAL DIALOGUE
--------------------------------------------------

local function Dialogue(Message,Duration)

	if Dead or EncounterFinished then
		return false
	end

	DialogueToken += 1

	local Token =
		DialogueToken

	ShowDialogue()

	DialogueText.TextTransparency = 0
	DialogueName.TextTransparency = 0
	DialogueBox.BackgroundTransparency = 0.08

	DialogueText.Text =
		tostring(Message)

	local Start =
		os.clock()

	while os.clock() - Start < Duration do

		if Dead
			or EncounterFinished
			or Token ~= DialogueToken then

			return false
		end

		RunService.RenderStepped:Wait()
	end

	return true
end

