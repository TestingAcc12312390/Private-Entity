--------------------------------------------------

local function Normalize(Text)
	return string.lower(
		tostring(Text or "")
			:gsub("^%s*(.-)%s*$", "%1")
	)
end

local function IsCorrect(Input, Data)
	Input = Normalize(Input)

	for _, Answer in ipairs(Data[2]) do
		if Input == Normalize(Answer) then
			return true
		end
	end

	return false
end

local function Shuffle(Tab)
	for i = #Tab, 2, -1 do
		local j = math.random(1, i)
		Tab[i], Tab[j] = Tab[j], Tab[i]
	end
end

