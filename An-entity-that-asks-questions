local function GetEntityBounds()

	if not Entity or not Entity.Parent then
		return nil
	end

	local Success, CF, Size =
		pcall(function()

			local BoxCF, BoxSize =
				Entity:GetBoundingBox()

			return BoxCF, BoxSize
		end)

	if not Success then
		return nil
	end

	return {
		CF = CF,
		Size = Size,
		Top = CF.Position.Y + Size.Y / 2,
		Bottom = CF.Position.Y - Size.Y / 2
	}
end

