--//========================================================
--// SAY
--// NO FADE-IN
--// ONLY FADE-OUT
--//========================================================

local function Say(Text)

	if Despawning
		or FinalJumpscareStarted then

		return false
	end


	DialogueText.Text =
		Text

	DialogueText.TextTransparency =
		0

	DialogueText.TextStrokeTransparency =
		0


	task.wait(
		DIALOGUE_VISIBLE_TIME
	)


	if Despawning
		or FinalJumpscareStarted then

		DialogueText.Text =
			""

		return false
	end


	local FadeOut =
		TweenService:Create(

			DialogueText,

			TweenInfo.new(
				DIALOGUE_FADE_OUT,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.In
			),

			{
				TextTransparency = 1,
				TextStrokeTransparency = 1
			}
		)


	FadeOut:Play()

	FadeOut.Completed:Wait()


	DialogueText.Text =
		""

	return true

end


--//========================================================
--// START NORMAL DIALOGUE
--//========================================================

local function StartDialogue()

	if DialogueRunning then
		return
	end


	DialogueRunning =
		true


	task.spawn(function()

		task.wait(
			FIRST_DIALOGUE_DELAY
		)


		if Despawning
			or FinalJumpscareStarted then

			DialogueRunning =
				false

			return
		end


		Say(
			"Im here..."
		)


		while not Despawning
			and not FinalJumpscareStarted do

			task.wait(
				NORMAL_DIALOGUE_DELAY
			)


			if Despawning
				or FinalJumpscareStarted then

				break

			end


			Say(
				GetRandomDialogue()
			)

		end


		DialogueText.Text =
			""

		DialogueText.TextTransparency =
			1

		DialogueText.TextStrokeTransparency =
			1


		DialogueRunning =
			false

	end)

end


