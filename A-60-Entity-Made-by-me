--//========================================================

local function MakeDark()

	if Despawning then
		return
	end


	--====================================================
	-- START FROM CURRENT/NORMAL LIGHTING
	--====================================================

	Lighting.Brightness =
		OriginalBrightness

	Lighting.Ambient =
		OriginalAmbient

	Lighting.OutdoorAmbient =
		OriginalOutdoorAmbient

	ColorCorrection.Brightness = 0
	ColorCorrection.Contrast = 0
	ColorCorrection.Saturation = 0

	Atmosphere.Density = 0
	Atmosphere.Haze = 0


	--====================================================
	-- ROOM SETTINGS
	--====================================================

	Lighting.ClockTime = 0

	Lighting.FogStart = 5
	Lighting.FogEnd = 55


	--====================================================
	-- DARKNESS TARGET
	--====================================================

	local DarkTween =
		TweenService:Create(

			Lighting,

			TweenInfo.new(
				DARKNESS_FADE_TIME,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.InOut
			),

			{
				Brightness = 0.45,

				Ambient =
					Color3.fromRGB(
						18,
						18,
						18
					),

				OutdoorAmbient =
					Color3.fromRGB(
						10,
						10,
						10
					)
			}
		)


	--====================================================
	-- COLOR DARKNESS
	--====================================================

	local ColorTween =
		TweenService:Create(

			ColorCorrection,

			TweenInfo.new(
				DARKNESS_FADE_TIME,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.InOut
			),

			{
				Brightness = -0.25,
				Contrast = 0.38,
				Saturation = -0.45
			}
		)


	--====================================================
	-- ATMOSPHERE DARKNESS
	--====================================================

	local AtmosphereTween =
		TweenService:Create(

			Atmosphere,

			TweenInfo.new(
				DARKNESS_FADE_TIME,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.InOut
			),

			{
				Density = 0.42,
				Haze = 2.2
			}
		)


	DarkTween:Play()
	ColorTween:Play()
	AtmosphereTween:Play()

end


--//========================================================
--// DARKNESS FADE-OUT
--//========================================================
--// Called when the entity is ABOUT TO DESPAWN.
--// Everything smoothly returns to the original lighting.

local function FadeOutDarkness()

	if not ColorCorrection
		or not Atmosphere then

		return
	end


	--====================================================
	-- RESTORE CLOCK / FOG IMMEDIATELY
	--====================================================

	local ClockTween =
		TweenService:Create(

			Lighting,

			TweenInfo.new(
				DARKNESS_FADE_OUT_TIME,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),

			{
				Brightness =
					OriginalBrightness,

				ClockTime =
					OriginalClockTime,

				FogStart =
					OriginalFogStart,

				FogEnd =
					OriginalFogEnd,

				Ambient =
					OriginalAmbient,

				OutdoorAmbient =
					OriginalOutdoorAmbient
			}
		)


	--====================================================
	-- COLOR CORRECTION FADE OUT
	--====================================================

	local ColorFadeOut =
		TweenService:Create(

			ColorCorrection,

			TweenInfo.new(
				DARKNESS_FADE_OUT_TIME,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),

			{
				Brightness = 0,
				Contrast = 0,
				Saturation = 0
			}
		)


	--====================================================
	-- ATMOSPHERE FADE OUT
	--====================================================

	local AtmosphereFadeOut =
		TweenService:Create(

			Atmosphere,

			TweenInfo.new(
				DARKNESS_FADE_OUT_TIME,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),

			{
				Density = 0,
				Haze = 0
			}
		)


	ClockTween:Play()
	ColorFadeOut:Play()
	AtmosphereFadeOut:Play()

end


