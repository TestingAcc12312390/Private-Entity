--//========================================================
--// GET RANDOM JUMPSCARE LINES
--//========================================================

local function GetRandomJumpscareLines()

	local Available = {}


	for _, Line in ipairs(
		JumpscareLines
	) do

		table.insert(
			Available,
			Line
		)

	end


	local Selected = {}


	for i = 1,
		JUMPSCARE_LINE_COUNT do

		if #Available <= 0 then
			break
		end


		local Index =
			math.random(
				1,
				#Available
			)


		table.insert(
			Selected,
			Available[Index]
		)


		table.remove(
			Available,
			Index
		)

	end


	return Selected

end


--//========================================================
--// CAMERA SHAKE
--//========================================================

local function BrutalCameraShake(Duration)

	local Camera =
		workspace.CurrentCamera

	if not Camera then
		return
	end


	local Start =
		tick()


	while tick() - Start <
		Duration do

		if Despawning then
			break
		end


		local Strength =
			2.5


		local X =
			math.random(
				-100,
				100
			) / 100
			* Strength


		local Y =
			math.random(
				-100,
				100
			) / 100
			* Strength


		local Z =
			math.random(
				-100,
				100
			) / 100
			* Strength


		local RX =
			math.rad(
				math.random(
					-25,
					25
				)
			)


		local RY =
			math.rad(
				math.random(
					-25,
					25
				)
			)


		local RZ =
			math.rad(
				math.random(
					-25,
					25
				)
			)


		Camera.CFrame =
			Camera.CFrame
			* CFrame.new(
				X,
				Y,
				Z
			)
			* CFrame.Angles(
				RX,
				RY,
				RZ
			)


		RunService.RenderStepped:Wait()

	end

end


