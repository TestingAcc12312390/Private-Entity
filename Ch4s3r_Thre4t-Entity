---====== DISPLAY ACHIEVEMENT ======---

local function GiveCh4s3rThreatAchievement()

    if Ch4s3rThre4tAchievementExecuted then
        return
    end

    Ch4s3rThre4tAchievementExecuted = true

    task.spawn(function()

        task.wait(0.15)

        local success, err = pcall(function()

            achievementGiver({

                Title = "???????????",

                Desc = "Come here :)",

                Reason = "Encounter Ch4s3r_Thre4t",

                Image = "rbxassetid://73629873132008"

            })

        end)

        if success then

            print(
                "Ch4s3r_Thre4t achievement displayed!"
            )

        else

            warn(
                "Ch4s3r_Thre4t achievement failed:",
                err
            )

            Ch4s3rThre4tAchievementExecuted = false

        end

    end)

end


---====== STOP MUSIC ======---

local function StopCh4s3rThreatSound()

