---====== ON SPAWNED ======---

entity:SetCallback("OnSpawned", function()

    print(
        "Ch4s3r_Thre4t has spawned"
    )


    -- Reset achievement for this encounter
    Ch4s3rThre4tAchievementExecuted = false


    -- Remove previous music
    StopCh4s3rThreatSound()


    --====================================================
    -- CREATE CHASE MUSIC
    --====================================================

    cue2 = Instance.new("Sound")

    cue2.Name =
        "Ch4s3rThreat_ChaseMusic"

    cue2.SoundId =
        "rbxassetid://119285499667468"

    cue2.Volume =
        2

    cue2.PlaybackSpeed =
        1

    cue2.Looped =
        true

    cue2.Parent =
        workspace

    cue2:Play()


    --====================================================
    -- WATCH ENTITY
    --====================================================

    task.spawn(function()

        while cue2 do

            task.wait(0.05)

            if not cue2 then
                break
            end


            local foundEntity = false


            for _, obj in ipairs(
                workspace:GetDescendants()
            ) do

                if obj.Name == "Ch4s3r_Thre4t" then

                    foundEntity = true

                    break

                end

            end


            if not foundEntity then

                print(
                    "Ch4s3r_Thre4t disappeared from Workspace"
                )


                -- STOP MUSIC
                StopCh4s3rThreatSound()


                break

            end

        end

    end)

end)


