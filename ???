                math.random(-5, 5),
                0.93,
                math.random(-3, 3)
            )

        --==================================================
        -- WAIT
        --==================================================

        task.wait(2.6)

        --==================================================
        -- REVEAL
        --==================================================

        staticRunning = false

        pcall(function()
            music:Stop()
            music:Destroy()
        end)

        pcall(function()
            staticFolder:Destroy()
        end)

        dialogue.Visible = false

        --==================================================
        -- BOILED ONE IMAGE
        --==================================================

        local boiledOne =
            Instance.new("ImageLabel")

        boiledOne.AnchorPoint =
            Vector2.new(0.5, 0.5)

        boiledOne.Position =
            UDim2.fromScale(0.5, 0.5)

        boiledOne.Size =
            UDim2.fromScale(
                0.01,
                0.01
            )

        boiledOne.BackgroundTransparency = 1

        boiledOne.Image =
            BOILED_ONE_IMAGE

        boiledOne.ScaleType =
            Enum.ScaleType.Fit

        boiledOne.ZIndex = 100
        boiledOne.Parent = gui

        --==================================================
        -- SCREAM
        --==================================================

        local scream =
            Instance.new("Sound")

        scream.SoundId =
            SCREAM_SOUND

        scream.Volume = 10

        scream.Parent = gui

        scream:Play()

        TweenService:Create(
            boiledOne,

            TweenInfo.new(
                0.1,
                Enum.EasingStyle.Back,
                Enum.EasingDirection.Out
            ),

            {
                Size =
                    UDim2.fromScale(
                        0.9,
                        0.9
                    )
            }

        ):Play()

        --==================================================
        -- RED FLASH
        --==================================================

        white.BackgroundColor3 =
            Color3.fromRGB(
                255,
                0,
                0
            )

        task.wait(0.05)

        white.BackgroundColor3 =
            Color3.fromRGB(
                255,
                255,
                255
            )

        --==================================================
        -- JUMPSCARE HOLD
        --==================================================

        task.wait(1)

        --==================================================
        -- KILL PLAYER
        --==================================================

        local character =
            player.Character

        if character then

            local humanoid =
                character:FindFirstChildOfClass(
                    "Humanoid"
                )

            if humanoid then
                humanoid.Health = 0
            end

        end

        --==================================================
        -- DEATH CAUSE
        --==================================================

        pcall(function()

            game.ReplicatedStorage.GameStats[
                "Player_" .. player.Name
            ].Total.DeathCause.Value =
                "The Boiled One"

        end)

        --==================================================
        -- CLEANUP
        --==================================================

        task.wait(0.5)

        pcall(function()
            gui:Destroy()
        end)

    else

        print("Entity has damaged the player")

    end

end)

