                )

            bar.Position =
                UDim2.new(
                    math.random(-20, 100) / 100,
                    0,
                    math.random(-15, 100) / 100,
                    0
                )

            bar.ZIndex = 5
            bar.Parent = staticFolder

            table.insert(staticBars, bar)

        end

        --==================================================
        -- THIN SCANLINES
        --==================================================

        local scanLines = {}

        for i = 1, 100 do

            local line = Instance.new("Frame")

            line.BackgroundColor3 =
                Color3.fromRGB(
                    0,
                    0,
                    0
                )

            line.BackgroundTransparency =
                math.random(55, 90) / 100

            line.BorderSizePixel = 0

            line.Size =
                UDim2.new(
                    1,
                    0,
                    0,
                    math.random(1, 3)
                )

            line.Position =
                UDim2.new(
                    0,
                    0,
                    math.random(),
                    0
                )

            line.ZIndex = 6
            line.Parent = staticFolder

            table.insert(scanLines, line)

        end

        --==================================================
        -- LARGE GLITCH BLOCKS
        --==================================================

        local glitchBlocks = {}

        for i = 1, 55 do

            local block = Instance.new("Frame")

            block.BorderSizePixel = 0

            local shade = math.random(0, 255)

            block.BackgroundColor3 =
                Color3.fromRGB(
