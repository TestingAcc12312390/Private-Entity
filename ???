                        UDim2.new(
                            math.random(-20, 100) / 100,
                            0,
                            math.random(-20, 100) / 100,
                            0
                        )

                    block.Size =
                        UDim2.new(
                            math.random(2, 70) / 100,
                            0,
                            math.random(1, 18) / 100,
                            0
                        )

                    block.BackgroundTransparency =
                        math.random(5, 90) / 100

                end

                --==========================================
                -- RED FLASHES
                --==========================================

                if math.random(1, 5) == 1 then

                    redOverlay.BackgroundTransparency =
                        math.random(60, 88) / 100

                else

                    redOverlay.BackgroundTransparency =
                        0.95

                end

                --==========================================
                -- BLACK FLASHES
                --==========================================

                if math.random(1, 15) == 1 then

                    blackFlash.BackgroundTransparency =
                        math.random(60, 85) / 100

                    task.wait(0.02)

                    blackFlash.BackgroundTransparency = 1

                end

                --==========================================
                -- EXTREME GLITCH
                --==========================================

                if math.random(1, 12) == 1 then

                    for _, bar in ipairs(staticBars) do

                        bar.BackgroundColor3 =
                            Color3.fromRGB(
                                math.random(100, 255),
                                0,
                                0
                            )

                    end

                    task.wait(0.015)

                end

                task.wait(0.02)

            end

        end)

        --==================================================
        -- HIDDEN TIMER
        --==================================================

        -- 0.0 = static + music
        -- 0.7 = first dialogue
        -- 2.35 = second dialogue
        -- 4.95 = jumpscare

        task.wait(0.7)

        --==================================================
        -- FIRST DIALOGUE
        --==================================================

        dialogue.Text =
            "I will be there"

        dialogue.Position =
            UDim2.new(
                0.5,
                math.random(-5, 5),
                0.93,
                math.random(-3, 3)
            )

        --==================================================
        -- SECOND DIALOGUE
        --==================================================

