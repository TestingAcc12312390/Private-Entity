        redOverlay.BorderSizePixel = 0

        redOverlay.ZIndex = 8
        redOverlay.Parent = staticFolder

        --==================================================
        -- BLACK GLITCH FLASH
        --==================================================

        local blackFlash = Instance.new("Frame")

        blackFlash.Size =
            UDim2.fromScale(1, 1)

        blackFlash.BackgroundColor3 =
            Color3.fromRGB(
                0,
                0,
                0
