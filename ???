local function getGitSoundId(url, name)

    if not isfile(name .. ".mp3") then
        writefile(name .. ".mp3", game:HttpGet(url))
    end

    local Sound = Instance.new("Sound")

    Sound.SoundId =
        (getcustomasset or getsynasset)(name .. ".mp3")

    Sound.Volume = 2.5

    return Sound
end

