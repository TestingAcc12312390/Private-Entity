        dialogue.Text = ""

        -- RED TEXT
        dialogue.TextColor3 =
            Color3.fromRGB(
                180,
                0,
                0
            )

        -- Heavy black outline
        dialogue.TextStrokeColor3 =
            Color3.fromRGB(
                0,
                0,
                0
            )

        dialogue.TextStrokeTransparency = 0

        dialogue.TextScaled = true

        -- Scarier-looking font
        dialogue.Font =
            Enum.Font.Antique

        dialogue.ZIndex = 50
        dialogue.Parent = gui

        --==================================================
        -- TALKING MUSIC
        --==================================================

        local music = Instance.new("Sound")

        music.SoundId =
            TALKING_MUSIC

        music.Volume = 1.5

        -- ONLY PLAYS ONCE
        music.Looped = false

        music.Parent = gui

        --==================================================
        -- START EVERYTHING
        --==================================================

        local staticRunning = true

        music:Play()

        --==================================================
        -- STATIC LOOP
        --==================================================

        task.spawn(function()

            while staticRunning and gui.Parent do

                --==========================================
                -- STATIC BARS
                --==========================================

                for _, bar in ipairs(staticBars) do

                    local shade =
                        math.random(0, 255)

                    bar.BackgroundColor3 =
                        Color3.fromRGB(
